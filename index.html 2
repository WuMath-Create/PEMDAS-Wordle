      </div>
    </div>

    <div class="level-tabs">
      <button class="level-tab" data-level="1">Level 1 (Easy)</button>
      <button class="level-tab active" data-level="2">Level 2 (Med)</button>
      <button class="level-tab" data-level="3">Level 3 (Hard)</button>
    </div>

    <div class="message" id="message"></div>

    <div class="main-layout">
      <div class="grid-container">
        <div class="cw-grid" id="cw-grid"></div>
      </div>

      <div class="clues-container">
        <div class="clues-col">
          <div class="clues-title">Across</div>
          <div id="across-clues"></div>
        </div>
        <div class="clues-col">
          <div class="clues-title">Down</div>
          <div id="down-clues"></div>
        </div>
      </div>
    </div>

    <div class="controls-row">
      <button class="action-btn primary" id="check-btn">Check Puzzle</button>
    </div>

    <!-- Help Modal -->
    <div class="modal-overlay" id="help-modal">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-title">HOW TO PLAY</div>
          <button class="close-btn" id="close-help">&times;</button>
        </div>
        <div class="help-body">
          <p>Complete the daily crossword puzzle using CCSS math vocabulary words!</p>
          <ul>
            <li><strong>Level 1:</strong> 5 words (Kindergarten to 3rd Grade vocabulary).</li>
            <li><strong>Level 2:</strong> 10 words (Kindergarten to 5th Grade vocabulary).</li>
            <li><strong>Level 3:</strong> 20 words (All Grade Levels K through High School).</li>
            <li>Click a cell to select it. Click again to toggle between <strong>Across</strong> and <strong>Down</strong>.</li>
            <li>Use your keyboard to enter letters and <strong>Check Puzzle</strong> when complete.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Stats Modal -->
    <div class="modal-overlay" id="stats-modal">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-title">STATISTICS</div>
          <button class="close-btn" id="close-stats">&times;</button>
        </div>
        <div class="stats-summary">
          <div class="stat-box">
            <div class="stat-val" id="stat-played">0</div>
            <div class="stat-lbl">Played</div>
          </div>
          <div class="stat-box">
            <div class="stat-val" id="stat-winrate">0%</div>
            <div class="stat-lbl">Win %</div>
          </div>
          <div class="stat-box">
            <div class="stat-val" id="stat-streak">0</div>
            <div class="stat-lbl">Streak</div>
          </div>
          <div class="stat-box">
            <div class="stat-val" id="stat-maxstreak">0</div>
            <div class="stat-lbl">Max Streak</div>
          </div>
        </div>
      </div>
    </div>
  </div>


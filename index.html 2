<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Daily Math Crossword</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    body { background-color: #f8f9fa; color: #1a1a1a; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 16px; }
    .app-container { background: #ffffff; width: 100%; max-width: 850px; padding: 24px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); position: relative; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .header h1 { font-size: 26px; font-weight: 700; color: #111; }
    .header-actions { display: flex; gap: 10px; }
    .icon-btn { background: #e9ecef; border: none; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: bold; transition: background 0.2s; }
    .icon-btn:hover { background: #dee2e6; }
    .level-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
    .level-tab { flex: 1; padding: 10px 0; background: #f1f3f5; border: 2px solid transparent; border-radius: 8px; font-size: 14px; font-weight: 700; color: #495057; cursor: pointer; text-align: center; transition: all 0.2s; }
    .level-tab:hover { background: #e9ecef; }
    .level-tab.active { background: #e7f5ff; border-color: #0d6efd; color: #0d6efd; }
    .message { text-align: center; font-size: 15px; font-weight: 600; min-height: 22px; margin-bottom: 16px; color: #dc3545; }
    .main-layout { display: flex; gap: 20px; align-items: flex-start; margin-bottom: 20px; }
    .grid-container { flex: 1; display: flex; justify-content: center; overflow-x: auto; }
    .cw-grid { display: grid; gap: 2px; background: #333; padding: 2px; border-radius: 6px; width: 100%; max-width: 440px; aspect-ratio: 1; }
    .cw-cell { background: #111; position: relative; display: flex; align-items: center; justify-content: center; user-select: none; }
    .cw-cell.active { background: #fff; cursor: pointer; }
    .cw-cell.word-highlight { background: #90caf9 !important; }
    .cw-cell.selected { background: #42a5f5 !important; }
    .cw-cell.correct { background: #d4edda !important; color: #155724; }
    .cw-num { position: absolute; top: 2px; left: 3px; font-size: 9px; font-weight: 700; color: #333; pointer-events: none; }
    .cw-val { font-size: 16px; font-weight: 700; color: #111; text-transform: uppercase; }
    .clues-container { flex: 1; display: flex; flex-direction: column; gap: 16px; background: #f1f3f5; padding: 16px; border-radius: 10px; height: 440px; overflow-y: auto; }
    .clues-col { flex: 1; }
    .clues-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: #495057; margin-bottom: 8px; border-bottom: 2px solid #ced4da; padding-bottom: 4px; }
    .clue-item { font-size: 13px; margin-bottom: 6px; color: #212529; cursor: pointer; line-height: 1.4; padding: 4px 6px; border-radius: 4px; }
    .clue-item:hover { background: #e9ecef; }
    .clue-item.active { background: #0d6efd; color: #fff; font-weight: 600; }
    .controls-row { display: flex; gap: 12px; }
    .action-btn { flex: 1; padding: 12px 0; border: none; background: #e9ecef; border-radius: 8px; font-size: 14px; font-weight: 600; color: #111; cursor: pointer; transition: background 0.2s; }
    .action-btn:hover { background: #dee2e6; }
    .action-btn.primary { background: #0d6efd; color: #fff; }
    .action-btn.primary:hover { background: #0b5ed7; }
    @media (max-width: 650px) { .main-layout { flex-direction: column; } .clues-container { width: 100%; height: 220px; } }
    .modal-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); border-radius: 16px; display: none; justify-content: center; align-items: center; z-index: 10; }
    .modal-overlay.open { display: flex; }
    .modal-content { background: #ffffff; width: 90%; max-width: 400px; padding: 24px; border-radius: 12px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .modal-title { font-size: 20px; font-weight: 700; }
    .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: #6c757d; }
    .stats-summary { display: flex; justify-content: space-between; margin-bottom: 20px; text-align: center; }
    .stat-box { flex: 1; }
    .stat-val { font-size: 22px; font-weight: 700; }
    .stat-lbl { font-size: 11px; color: #6c757d; text-transform: uppercase; }
    .help-body { font-size: 14px; line-height: 1.5; color: #333; }
    .help-body p { margin-bottom: 10px; }
    .help-body ul { margin-left: 20px; margin-bottom: 12px; }
  </style>
</head>
<body>

  <div class="app-container">
    <div class="header">
      <h1>Math Crossword</h1>
      <div class="header-actions">
        <button class="icon-btn" id="help-btn" title="How to Play">?</button>
